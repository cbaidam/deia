type: LiquidTurret
name: Lékař
description: Střílí Antineoplazmu, která neoplazmu zničí, nebo Stabilizátor, který ji změní na prospěšnou. Obě kapaliny se musí vyrobit.
size: 3
health: 900
range: 190
targetHealing: true   // automaticky míří na poškozené spojence
targetAir: false      // nestřílí na nepřátele
targetGround: false
extinguish: false     // neplýtvá léčivem na hašení
liquidCapacity: 60
ammoUseEffect: none
inaccuracy: 2
rotateSpeed: 6
reload: 3

ammoTypes: {
  anti-neoplasm: {
    type: LiquidBulletType
    liquid: anti-neoplasm
    damage: 0.5
    speed: 4
    knockback: 0.1
    puddleSize: 10
    orbSize: 4
    collidesTeam: true
    healPercent: 3
  }
  stabilizer: {
    type: LiquidBulletType
    liquid: stabilizer
    damage: 0.5
    speed: 4
    knockback: 0.1
    puddleSize: 10
    orbSize: 4
    collidesTeam: true
    healPercent: 3
  }
}

requirements: [
  copper/80
  lead/60
  graphite/50
  silicon/50
  titanium/30
]

category: effect

research: {
  parent: neothera
}
